{
  "name": "jedit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "quality": "node scripts/quality-gate.mjs",
    "test": "node --test spec/**/*.spec.mjs tests/**/*.spec.mjs",
    "check": "npm run build && npm run test && npm run quality"
  },
  "dependencies": {
    "@flyingrobots/bijou": "latest",
    "@flyingrobots/bijou-node": "latest",
    "@flyingrobots/bijou-tui": "latest",
    "@flyingrobots/bijou-tui-app": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
