// ContentAddressV1 ids for the fresh nodes, and the normalized proposal of
// the reachable fresh nodes and their edges.
//
// A stored node keeps its row id; fresh ids are computed over the two small
// fresh lists. Emission follows the reachable fresh nodes only. Repeated text
// yields repeated ids, and each id is emitted once.
package jedit.text.proposal@1;

use target echo.dpo@2 digest "sha256:7cadb97e7e2d3f586f3e16ebfe5b357346a33a4e27f3beeb63f0b8889835cc50" as echo;
use module jedit.text.codec@1 digest "sha256:10a1ffafc935e66900597a11fc5ad0a32d045d839acaa3c6f67ab11a18478744" as codec;
use module jedit.text.identity@1 digest "sha256:95b57d129a1ffd66fde24f6ea21352f43abf493543bdc8ee3192e70042a48366" as ids;
use module jedit.text.rope@1 digest "sha256:0b1d298e609f70ebaca17d420d6c9eee3986c9e4d5cc260ceed09771701dd4f8" as rope;
use module jedit.text.closure@1 digest "sha256:b871b39335b77d1e469b12fbc155407081ca2cfb46f7ec4efb9d1ce8456159cd" as closure;

type Id = Bytes<exact=32>;
type Pieces = { replacement: Bytes<max=16384>, rewritten: Bytes<max=25088> };
type Outgoing = { edgeType: Id, to: Id };

// A fresh node's atom.
fn leafBytes(c: closure.Closure, pieces: Pieces, n: rope.Node) -> Bytes<max=25088> {
  let row = closure.rowOf(c, n.source);
  let stored = codec.leafFact(row.atomBytes).fact.bytes;
  let piece = if n.source == 0u64 then pieces.replacement else pieces.rewritten;
  return if n.row && n.from <= n.to && n.to <= len(stored) then slice(stored, n.from, n.to)
    else if !n.row && n.from <= n.to && n.to <= len(piece) then slice(piece, n.from, n.to)
    else b"";
}
// Slicing never narrows a byte bound, so a fresh atom keeps the bound of the
// largest piece; Echo's ensure-node admits that bound.
type FreshAtom = Bytes<max=25344>;
fn atomOf(c: closure.Closure, pieces: Pieces, n: rope.Node) -> FreshAtom {
  let bytes = leafBytes(c, pieces, n);
  return if n.leaf then codec.pieceAtom(bytes, n.lineBreaks)
    else codec.branchAtom({ byteLength: n.byteLength, lineBreaks: n.lineBreaks, height: n.height });
}

// ---- ids of the fresh nodes ----
//
// Stored nodes keep their row ids. Fresh leaves are hashed first; a fresh
// branch's children are stored nodes, fresh leaves or earlier fresh branches,
// so one pass over each small fresh list computes every id.

type Ids = { leaves: List<Id, max=16>, branches: List<Id, max=128> };
type Hashing = { closure: closure.Closure, pieces: Pieces, warp: Id, arena: rope.Arena, ids: Ids };

fn idOf(c: closure.Closure, arena: rope.Arena, known: Ids, i: U64) -> Id {
  let n = rope.node(arena, i);
  return if n.stored then closure.rowOf(c, n.source).nodeId
    else if 256u64 <= i && i - 256u64 < listLen(known.leaves) then listAt(known.leaves, i - 256u64)
    else if 272u64 <= i && i - 272u64 < listLen(known.branches) then listAt(known.branches, i - 272u64)
    else ids.leafType();
}

fn leafIdStep(s: Hashing) -> Hashing {
  let used = listLen(s.ids.leaves);
  let n = rope.node(s.arena, if used < 16u64 then 256u64 + used else rope.absent());
  let id = echo.contentAddress(s.warp, ids.leafType(), ids.leafAtomType(), atomOf(s.closure, s.pieces, n), []);
  return if used < 16u64 && used < listLen(s.arena.leaves) && listLen(s.ids.leaves) < 16u64
    then { closure: s.closure, pieces: s.pieces, warp: s.warp, arena: s.arena,
      ids: { leaves: listAppend(s.ids.leaves, id), branches: s.ids.branches } }
    else s;
}

fn branchIdStep(s: Hashing) -> Hashing {
  let used = listLen(s.ids.branches);
  let n = rope.node(s.arena, if used < 128u64 then 272u64 + used else rope.absent());
  let edges: List<Outgoing, max=2> = [{ edgeType: ids.leftEdge(), to: idOf(s.closure, s.arena, s.ids, n.left) },
    { edgeType: ids.rightEdge(), to: idOf(s.closure, s.arena, s.ids, n.right) }];
  let id = echo.contentAddress(s.warp, ids.branchType(), ids.branchAtomType(), atomOf(s.closure, s.pieces, n), edges);
  return if used < 128u64 && used < listLen(s.arena.branches) && listLen(s.ids.branches) < 128u64
    then { closure: s.closure, pieces: s.pieces, warp: s.warp, arena: s.arena,
      ids: { leaves: s.ids.leaves, branches: listAppend(s.ids.branches, id) } }
    else s;
}

fn freshIds(c: closure.Closure, pieces: Pieces, warp: Id, arena: rope.Arena) -> Ids {
  let start: Hashing = { closure: c, pieces, warp, arena, ids: { leaves: [], branches: [] } };
  let leaves = fold(start, leafIdStep, 16u64);
  return fold(leaves, branchIdStep, 128u64).ids;
}

// ---- the normalized proposal ----
//
// Emission lists the arena indexes to write, in walk order, each id once. The
// intent builds each write as it emits.

type Context = { closure: closure.Closure, pieces: Pieces, warp: Id, arena: rope.Arena, ids: Ids };
type NodeWrite = { atomBytes: FreshAtom, atomType: Id, nodeId: Id, nodeType: Id, warpId: Id };
type EdgeWrite = { edgeId: Id, edgeType: Id, fromId: Id, toId: Id, warpId: Id };

fn nodeWrite(x: Context, i: U64) -> NodeWrite {
  let n = rope.node(x.arena, i);
  return { atomBytes: atomOf(x.closure, x.pieces, n), atomType: if n.leaf then ids.leafAtomType() else ids.branchAtomType(),
    nodeId: idOf(x.closure, x.arena, x.ids, i), nodeType: if n.leaf then ids.leafType() else ids.branchType(),
    warpId: x.warp };
}
fn isBranch(x: Context, i: U64) -> Bool { return !rope.node(x.arena, i).leaf; }
fn childWrite(x: Context, i: U64, right: Bool) -> EdgeWrite {
  let n = rope.node(x.arena, i);
  let from = idOf(x.closure, x.arena, x.ids, i);
  let edgeType = if right then ids.rightEdge() else ids.leftEdge();
  let to = idOf(x.closure, x.arena, x.ids, if right then n.right else n.left);
  return { edgeId: ids.edgeId(x.warp, from, edgeType, to), edgeType, fromId: from, toId: to, warpId: x.warp };
}

// Whether an id was already emitted. A ContentAddressV1 id commits to the
// node type, the atom and the complete edge set, so an equal id is equal
// content; two contents under one id would need a BLAKE3 collision.
type Seen = { emitted: List<Id, max=144>, id: Id, next: U64, found: Bool };
fn seenStep(s: Seen) -> Seen {
  let repeats = s.next < listLen(s.emitted) && listAt(s.emitted, s.next) == s.id;
  return if s.next < 144u64 then { emitted: s.emitted, id: s.id, next: s.next + 1u64, found: s.found || repeats } else s;
}

type Emit = {
  context: Context, order: List<U64, max=256>, next: U64,
  emitted: List<U64, max=144>, emittedIds: List<Id, max=144>, fault: U64,
};

fn emitStep(s: Emit) -> Emit {
  let index = if s.next < listLen(s.order) then listAt(s.order, s.next) else rope.absent();
  let id = idOf(s.context.closure, s.context.arena, s.context.ids, index);
  let found = fold({ emitted: s.emittedIds, id, next: 0u64, found: false }, seenStep, 144u64).found;
  let fresh = !found && listLen(s.emitted) < 144u64 && listLen(s.emittedIds) < 144u64;
  let emitted = if fresh && listLen(s.emitted) < 144u64 then listAppend(s.emitted, index) else s.emitted;
  let emittedIds = if fresh && listLen(s.emittedIds) < 144u64 then listAppend(s.emittedIds, id) else s.emittedIds;
  return if s.fault == rope.ok() && s.next < listLen(s.order) && s.next < 256u64
    then { context: s.context, order: s.order, next: s.next + 1u64, emitted, emittedIds, fault: s.fault }
    else s;
}

type Proposal = { context: Context, emitted: List<U64, max=144>, rootId: Id, fault: U64 };

fn propose(c: closure.Closure, pieces: Pieces, warp: Id, arena: rope.Arena, root: U64) -> Proposal {
  let context: Context = { closure: c, pieces, warp, arena, ids: freshIds(c, pieces, warp, arena) };
  let fresh = rope.freshNodes(arena, root);
  let final = fold({ context, order: fresh.order, next: 0u64, emitted: [], emittedIds: [], fault: fresh.fault }, emitStep, 144u64);
  return { context, emitted: final.emitted, rootId: idOf(c, arena, context.ids, root), fault: final.fault };
}
