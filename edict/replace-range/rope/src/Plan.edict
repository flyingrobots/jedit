package jedit.text.plan@1;

use target echo.dpo@2 digest "sha256:7cadb97e7e2d3f586f3e16ebfe5b357346a33a4e27f3beeb63f0b8889835cc50" as echo;
use module jedit.text.codec@1 digest "sha256:1510fea37ca4cf23cc8a74f17328f04c6461c2173e0b541ba9734148befc2198" as codec;
use module jedit.text.identity@1 digest "sha256:5a9c36eddade979810be7c2806bbf5eae43c69b7a8eda598152309e4c6b54011" as ids;
use module jedit.text.rope@1 digest "sha256:4838c1ce441c5d6d3116608dfd1aa2061244ce7d0b947c7b853773c34bc810f1" as rope;
use module jedit.text.flat@1 digest "sha256:b129fcb93d473ceb7c3bc0248fa6131512f773f2bb74bfc2678b719f05c6bcf9" as flat;
use module jedit.text.build@1 digest "sha256:d23be858e5445144c089f3357162e0900eee8043b3fb4f9868937bb7b1538fb9" as build;
use module jedit.text.closure@1 digest "sha256:643c540febac25226594faaaaf5eca5280ff16e72c30e10b3675c25708985a90" as closure;
use module jedit.text.proposal@1 digest "sha256:2758d99a7b84fc67ef262649a6cfdda9186f3ef72296908a54d81983918ed347" as proposal;

// The pure ReplaceRange plan over one closure read: Head checks, the
// validated arena, construction, character boundaries, the no-op check,
// counters and the normalized proposal. Its `code` names the first failing
// check in the documented precedence; the intent maps each code to its
// typed obstruction.

type Id = Bytes<exact=32>;
// `anchors` counts the basis Head's anchor edges; exactly one is lawful.
type Request = { warp: Id, basis: Id, anchor: Id, anchors: U64, start: U64, end: U64, replacement: build.Replacement };

// Outcome codes, in check precedence.
fn committed() -> U64 { return 0u64; }
fn headMalformed() -> U64 { return 1u64; }
fn rangeOutOfBounds() -> U64 { return 2u64; }
fn identityMismatch() -> U64 { return 3u64; }
fn malformedRope() -> U64 { return 4u64; }
fn factMalformed() -> U64 { return 5u64; }
fn resourceLimit() -> U64 { return 6u64; }
fn closureInsufficient() -> U64 { return 7u64; }
fn arithmeticOverflow() -> U64 { return 8u64; }
fn boundaryInvalid() -> U64 { return 9u64; }
fn noOp() -> U64 { return 10u64; }

type Plan = {
  code: U64, head: codec.HeadFact, rooted: Bool, rootId: Id, proposal: proposal.Proposal,
};

// The code of a fold fault.
// A loop that ends before its algorithm finishes is an envelope refusal, never
// a completed edit.
fn faultCode(fault: U64) -> U64 {
  return if fault == rope.incompleteFault() then resourceLimit()
    else if fault == rope.closureFault() then closureInsufficient()
    else if fault == rope.overflowFault() then arithmeticOverflow()
    else if fault == rope.capacityFault() then resourceLimit()
    else if fault == rope.malformedFault() then malformedRope()
    else if fault == rope.factFault() then factMalformed()
    else if fault == rope.identityFault() then identityMismatch()
    else committed();
}

// ---- leaf bytes by closure row ----

fn bytesAt(c: closure.Closure, arena: rope.Arena, i: U64) -> build.LeafBytes {
  return build.rowBytes(c, rope.node(arena, i).source);
}

// ---- construction ----

type Built = { tree: rope.Built, pieces: proposal.Pieces };

fn general(arena: rope.Arena, c: closure.Closure, q: Request) -> rope.Built {
  let first = rope.find(arena, 0u64, q.start, false);
  let firstBytes = bytesAt(c, arena, first.leaf);
  let prefixBreaks = if first.local <= len(firstBytes) then count(slice(firstBytes, 0u64, first.local), b"\n") else 0u64;
  let last = rope.find(arena, 0u64, q.end, false);
  let lastBytes = bytesAt(c, arena, last.leaf);
  let suffixBreaks = if last.local <= len(lastBytes) then count(slice(lastBytes, last.local, len(lastBytes)), b"\n") else 0u64;
  let prefix = flat.cut(arena, 0u64, q.start, true, prefixBreaks);
  let middle = build.fromBytes(prefix.arena, q.replacement);
  let left = rope.join(middle.arena, prefix.root, middle.root);
  let suffix = flat.cut(left.arena, 0u64, q.end, false, suffixBreaks);
  let whole = rope.join(suffix.arena, left.root, suffix.root);
  let fault = max(max(max(first.fault, last.fault), max(prefix.fault, middle.fault)), max(max(left.fault, suffix.fault), whole.fault));
  return { arena: whole.arena, root: whole.root, fault };
}

fn construct(arena: rope.Arena, c: closure.Closure, q: Request) -> Built {
  let located = build.locate(arena, 0u64, q.start, q.end);
  let leaf = bytesAt(c, arena, located.cur);
  let bytes = build.rewritten(leaf, located.start, located.end, q.replacement);
  let leafCase = rope.present(arena, 0u64) && !located.spanning && located.fault == rope.ok()
    && rope.node(arena, located.cur).leaf && 0u64 < len(bytes) && len(bytes) <= 4096u64;
  let pieces: proposal.Pieces = { replacement: q.replacement, rewritten: bytes };
  let rewrite = build.rewrite(located, len(bytes), count(bytes, b"\n"));
  let fresh = if rope.present(arena, 0u64) then general(arena, c, q) else build.fromBytes(arena, q.replacement);
  return { tree: if leafCase then rewrite else fresh, pieces };
}

// Whether an offset falls inside a code point of the basis text.
fn splits(arena: rope.Arena, c: closure.Closure, offset: U64) -> Bool {
  let found = rope.find(arena, 0u64, offset, true);
  return rope.present(arena, 0u64) && !build.leafBoundary(bytesAt(c, arena, found.leaf), found.local);
}

// ---- the plan ----

fn headId(q: Request, atom: codec.Atom, rooted: Bool, root: Id) -> Id {
  return if rooted then ids.rootedHeadId(q.warp, atom, root, q.anchor) else ids.emptyHeadId(q.warp, atom, q.anchor);
}

fn plan(c: closure.Closure, q: Request) -> Plan {
  let headRow = closure.rowOf(c, if 0u64 < listLen(c.occurrences) then listAt(c.occurrences, 0u64).node else 4294967295u64);
  let head = codec.headFact(headRow.atomBytes);
  let rootEdge = closure.edgeAt(c, 0u64);
  let rooted = rootEdge.from == 0u64 && rootEdge.slot == 0u64;
  let rootRow = closure.rowOf(c, rootEdge.node);
  let loaded = closure.load(c, q.warp);
  let root = rope.node(loaded.arena, 0u64);
  let identity = q.anchors == 1u64 && headId(q, headRow.atomBytes, rooted, rootRow.nodeId) == q.basis;
  let shape = if rooted then root.byteLength == head.fact.byteLength
      && isSome(checkedAdd(root.lineBreaks, 1u64)) && default(checkedAdd(root.lineBreaks, 1u64), 0u64) == head.fact.lineCount
    else head.fact.byteLength == 0u64 && head.fact.lineCount == 1u64;
  let built = construct(loaded.arena, c, q);
  let same = build.sameBytes(loaded.arena, c, 0u64, q.start, q.end, q.replacement);
  let tree = built.tree;
  let top = rope.node(tree.arena, tree.root);
  let lineCount = checkedAdd(if rope.present(tree.arena, tree.root) then top.lineBreaks else 0u64, 1u64);
  let sequence = checkedAdd(head.fact.sequence, 1u64);
  let p = proposal.propose(c, built.pieces, q.warp, tree.arena, tree.root);
  let code = if !head.ok || headRow.atomType != ids.headAtomType() || headRow.nodeType != ids.headType() then headMalformed()
    else if head.fact.byteLength < q.end then rangeOutOfBounds()
    else if !identity then identityMismatch()
    else if loaded.fault != rope.ok() then faultCode(loaded.fault)
    else if !shape then malformedRope()
    else if rooted && 14u64 < root.height then resourceLimit()
    else if built.tree.fault != rope.ok() then faultCode(built.tree.fault)
    else if same.fault != rope.ok() then faultCode(same.fault)
    else if splits(loaded.arena, c, q.start) || splits(loaded.arena, c, q.end) then boundaryInvalid()
    else if same.equal then noOp()
    else if !isSome(lineCount) || !isSome(sequence) then arithmeticOverflow()
    else if p.fault != rope.ok() then faultCode(p.fault)
    else if rope.present(tree.arena, tree.root) && 14u64 < top.height then resourceLimit()
    else if !proposal.fitsEcho(p) then resourceLimit()
    else committed();
  let next: codec.HeadFact = {
    byteLength: if rope.present(tree.arena, tree.root) then top.byteLength else 0u64,
    lineCount: default(lineCount, 0u64), sequence: default(sequence, 0u64),
  };
  return { code, head: next, rooted: rope.present(tree.arena, tree.root), rootId: p.rootId, proposal: p };
}
