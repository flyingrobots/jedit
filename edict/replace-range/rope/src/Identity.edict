// Schema-2 type identities and ContentAddressV1 ids for the text facts.
// Every id is computed by Echo's generic identity law, never an
// application recipe. The type ids are BLAKE3 over "type:" and the label.
package jedit.text.identity@1;

use target echo.dpo@2 digest "sha256:d17fbd0baf7bfddd9a6c9667e676db2ab45bae104e77550760340bc8f0736003" as echo;

type Id = Bytes<exact=32>;

// jedit.text.v2.Buffer
fn bufferType() -> Id { return b"\x2a\x3f\x0e\x12\x7b\x74\x60\xa4\x90\x8b\xe5\xaf\x8f\xe1\x4f\x50\xc0\x92\x58\x73\x16\x9e\xfb\x74\x88\x1a\x9f\xf8\x09\x2f\x0a\xe3"; }
// jedit.text.v2.BufferFact
fn bufferAtomType() -> Id { return b"\x12\x7b\xc5\x9c\xb6\x2a\xe8\x14\x08\x0c\x3d\x68\x64\xc9\x11\xf7\xb9\x54\x47\x0e\x3f\xc2\xe5\x5a\x51\x92\x5c\x32\x04\x6f\x54\x12"; }
// jedit.text.v2.Head
fn headType() -> Id { return b"\x65\x16\x59\xf3\xe2\xb5\x56\xe0\xfb\x11\x89\x2d\xf5\x40\xc6\xa2\x2c\xd0\x42\x7c\x11\x23\x7c\x0b\x74\xb6\xa7\x83\xbf\xcf\x61\x05"; }
// jedit.text.v2.HeadFact
fn headAtomType() -> Id { return b"\x40\x61\x3c\x7a\xc9\xf3\x97\xed\x4c\xb8\x89\x4f\xc0\x08\xcd\xc3\xfb\x1f\x8e\x11\x35\x58\x7a\x24\x0b\x13\xa2\x6b\x69\x85\x8d\x9d"; }
// jedit.text.v2.Branch
fn branchType() -> Id { return b"\x6b\x8c\xb0\x3c\x2f\x17\xcc\xd3\x8d\x35\xf2\xb6\xd9\xc3\x9a\x7d\xe8\x29\x55\xb1\x25\xb3\x96\xac\x50\x20\xd5\x15\x8f\x79\x81\xca"; }
// jedit.text.v2.BranchFact
fn branchAtomType() -> Id { return b"\x2e\x45\x5f\x18\x12\x42\x2c\x4a\x06\x6f\x8f\xfd\xec\x60\x5b\xbd\xe6\xed\x4f\x5c\x4e\xc5\x13\x1d\x04\x4c\x22\x6c\xd1\x7b\xa2\xf3"; }
// jedit.text.v2.Leaf
fn leafType() -> Id { return b"\x44\xc3\xa6\x68\x4e\x69\x72\x0b\x3d\x72\xd1\x61\x26\x1a\xd7\xf1\x8f\x9b\x59\x0e\x5c\x02\x88\x72\x71\x16\xe8\x0f\x7e\x47\xce\x4d"; }
// jedit.text.v2.LeafFact
fn leafAtomType() -> Id { return b"\x88\xa3\x03\xfe\xca\x83\x0b\x5a\x39\x4a\xa7\x2d\x56\x1c\x76\xa4\x69\xea\xd9\x98\x66\x29\x72\x07\xbb\x19\x6a\xf4\x7a\x70\xd1\x34"; }
// jedit.text.canonicalHead
fn canonicalHeadEdge() -> Id { return b"\x88\x8e\x7a\x21\xb6\x19\x91\x78\x6e\x03\xce\x12\x61\x75\xab\x09\x7a\x91\x46\x18\x3a\xfb\xb4\x54\xe2\xde\x12\xc6\xc6\x3a\xb7\x75"; }
// jedit.text.root
fn rootEdge() -> Id { return b"\x86\xcf\xca\xf4\x43\x47\xf0\x37\x48\x8b\x93\x6a\x65\x48\x88\x0b\xcf\xe4\xf5\x3f\x86\xe2\xce\x81\xb2\x9e\xe5\xad\xda\x57\x66\x98"; }
// jedit.text.anchor
fn anchorEdge() -> Id { return b"\x02\x44\x38\x15\x79\x8a\xb1\xc2\x1d\xf3\xb8\x97\x0d\x6c\x0f\xd1\x3f\x5f\xd8\xb4\x9c\xff\xc7\xac\xcb\x76\x74\xdb\x46\x44\x68\x6e"; }
// jedit.text.left
fn leftEdge() -> Id { return b"\xee\xb5\xf5\x51\xa0\x98\x72\xc6\x23\xe5\x17\x6f\x6c\x1f\xf2\x4a\x5c\x72\x25\xd2\x15\x4b\x2a\x7c\xd3\xe6\x8a\xd8\x07\x60\x20\x3e"; }
// jedit.text.right
fn rightEdge() -> Id { return b"\x0b\x1a\xcd\x29\xf4\xc5\x2c\x61\x70\x22\x21\x3e\x07\x82\x9a\xc8\x65\x33\xa7\x62\xf4\xde\x8d\x96\x8e\x87\xb5\x8c\xdb\x33\x02\xa4"; }

fn leafId(warp: Id, atom: Bytes<max=4352>) -> Id {
  return echo.contentAddress(warp, leafType(), leafAtomType(), atom, []);
}
fn branchId(warp: Id, atom: Bytes<max=4352>, left: Id, right: Id) -> Id {
  return echo.contentAddress(warp, branchType(), branchAtomType(), atom,
    [{ edgeType: leftEdge(), to: left }, { edgeType: rightEdge(), to: right }]);
}
// A Head of non-empty text has a root edge; the empty Head has only its anchor.
fn rootedHeadId(warp: Id, atom: Bytes<max=4352>, root: Id, anchor: Id) -> Id {
  return echo.contentAddress(warp, headType(), headAtomType(), atom,
    [{ edgeType: rootEdge(), to: root }, { edgeType: anchorEdge(), to: anchor }]);
}
fn emptyHeadId(warp: Id, atom: Bytes<max=4352>, anchor: Id) -> Id {
  return echo.contentAddress(warp, headType(), headAtomType(), atom, [{ edgeType: anchorEdge(), to: anchor }]);
}
fn edgeId(warp: Id, from: Id, edgeType: Id, to: Id) -> Id { return echo.contentEdgeId(warp, from, edgeType, to); }
fn canonicalHeadSlot(warp: Id, buffer: Id) -> Id { return echo.slotEdgeId(warp, buffer, canonicalHeadEdge()); }
