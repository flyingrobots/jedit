// The persistent rope's reconstruction law over a bounded arena, following
// tests/support/replace-range-schema-2/rope-build.mts exactly: prefix and
// suffix by path copy, and AVL concatenation (join without a middle key).
//
// A rope is an arena of node records whose children are arena indexes; an
// index at or past the arena length is the empty rope. Stored nodes come from
// the closure read; an unexpanded stored branch has no known children, and
// asking for them is a closure fault. Fresh nodes are appended, so a fresh
// node's children always precede it. Every walk is a fold with a literal
// bound sized for text.maxTreeHeight = 32: a path stack of 32 and 66 steps.
// A fold cannot fail, so faults travel in the state and the callers map them.
package jedit.text.rope@1;

type Node = {
  stored: Bool, expanded: Bool, leaf: Bool,
  byteLength: U64, lineBreaks: U64, height: U64,
  left: U64, right: U64,
  // A leaf's bytes are source[from, to): a stored leaf row or the replacement.
  source: U64, from: U64, to: U64,
};
type Arena = List<Node, max=512>;

// Fault codes carried in fold state.
fn ok() -> U64 { return 0u64; }
fn closureFault() -> U64 { return 1u64; }
fn overflowFault() -> U64 { return 2u64; }
fn capacityFault() -> U64 { return 3u64; }
fn incompleteFault() -> U64 { return 4u64; }

fn absent() -> U64 { return 4294967295u64; }
fn emptyNode() -> Node {
  return { stored: false, expanded: false, leaf: true, byteLength: 0u64, lineBreaks: 0u64, height: 0u64,
    left: 4294967295u64, right: 4294967295u64, source: 0u64, from: 0u64, to: 0u64 };
}
fn node(arena: Arena, i: U64) -> Node { return if i < listLen(arena) then listAt(arena, i) else emptyNode(); }
fn height(arena: Arena, i: U64) -> U64 { return node(arena, i).height; }
fn byteLength(arena: Arena, i: U64) -> U64 { return node(arena, i).byteLength; }
fn present(arena: Arena, i: U64) -> Bool { return i < listLen(arena); }
// Whether i's children are known: a fresh branch, or a stored branch the closure expanded.
fn open(arena: Arena, i: U64) -> Bool {
  let n = node(arena, i);
  return present(arena, i) && !n.leaf && (n.expanded || !n.stored);
}

// Whether a is at most one more than b.
fn notTaller(a: U64, b: U64) -> Bool { return a <= b || (1u64 <= a && a - 1u64 <= b); }

type Built = { arena: Arena, root: U64, fault: U64 };

fn faulted(arena: Arena, fault: U64) -> Built { return { arena, root: absent(), fault }; }

// A fresh branch over two ropes. Line breaks are summed here and recomputed
// for every fresh branch once fresh leaves carry theirs.
fn branch(arena: Arena, l: U64, r: U64) -> Built {
  let ln = node(arena, l);
  let rn = node(arena, r);
  let length = checkedAdd(ln.byteLength, rn.byteLength);
  let breaks = checkedAdd(ln.lineBreaks, rn.lineBreaks);
  let taller = max(ln.height, rn.height);
  return if !(listLen(arena) < 512u64) then faulted(arena, capacityFault())
    else if isSome(length) && isSome(breaks) && taller < 255u64
      then {
        arena: listAppend(arena, {
          stored: false, expanded: true, leaf: false,
          byteLength: unwrap(length), lineBreaks: unwrap(breaks), height: taller + 1u64,
          left: l, right: r, source: 0u64, from: 0u64, to: 0u64,
        }),
        root: listLen(arena), fault: ok(),
      }
      else faulted(arena, overflowFault());
}

// Continues with b's arena when b did not fault.
fn branchOn(b: Built, l: U64, r: U64) -> Built { return if b.fault == ok() then branch(b.arena, l, r) else b; }

fn rotateLeft(b: Built) -> Built {
  let n = node(b.arena, b.root);
  let rn = node(b.arena, n.right);
  let inner = if b.fault == ok() && open(b.arena, b.root) && open(b.arena, n.right)
    then branch(b.arena, n.left, rn.left) else faulted(b.arena, max(b.fault, closureFault()));
  return branchOn(inner, inner.root, rn.right);
}
fn rotateRight(b: Built) -> Built {
  let n = node(b.arena, b.root);
  let ln = node(b.arena, n.left);
  let inner = if b.fault == ok() && open(b.arena, b.root) && open(b.arena, n.left)
    then branch(b.arena, ln.right, n.right) else faulted(b.arena, max(b.fault, closureFault()));
  let outer = branchOn(inner, ln.left, inner.root);
  return outer;
}

// ---- joinRight: the left rope is more than one level taller ----

type Join = {
  arena: Arena, path: List<U64, max=32>, remaining: U64, cur: U64, short: U64,
  rebuilding: Bool, done: Bool, carry: U64, fault: U64,
};

fn joinState(s: Join, b: Built, remaining: U64, rebuilding: Bool, done: Bool) -> Join {
  return { arena: b.arena, path: s.path, remaining, cur: s.cur, short: s.short,
    rebuilding, done: done || b.fault != ok(), carry: b.root, fault: b.fault };
}

// The base of joinRight at tall node cur, whose children are left and inner.
fn rightBase(arena: Arena, left: U64, inner: U64, short: U64) -> Built {
  let joined = branch(arena, inner, short);
  return if joined.fault != ok() then joined
    else if notTaller(height(joined.arena, joined.root), height(joined.arena, left))
      then branch(joined.arena, left, joined.root)
      else rotateLeft(branchOn(rotateRight(joined), left, rotateRight(joined).root));
}

fn rightDown(s: Join) -> Join {
  let n = node(s.arena, s.cur);
  let hs = height(s.arena, s.short);
  return if !open(s.arena, s.cur) then joinState(s, faulted(s.arena, closureFault()), 0u64, true, true)
    else if hs < 255u64 && height(s.arena, n.right) <= hs + 1u64
      then joinState(s, rightBase(s.arena, n.left, n.right, s.short), listLen(s.path), true, false)
    else if listLen(s.path) < 32u64
      then { arena: s.arena, path: listAppend(s.path, n.left), remaining: 0u64, cur: n.right, short: s.short,
        rebuilding: false, done: false, carry: s.carry, fault: s.fault }
      else joinState(s, faulted(s.arena, capacityFault()), 0u64, true, true);
}

fn rightUp(s: Join) -> Join {
  return if 1u64 <= s.remaining && s.remaining - 1u64 < listLen(s.path)
    then rightPop(s, listAt(s.path, s.remaining - 1u64), s.remaining - 1u64)
    else joinState(s, { arena: s.arena, root: s.carry, fault: s.fault }, s.remaining, true, true);
}
fn rightPop(s: Join, left: U64, remaining: U64) -> Join {
  let result = branch(s.arena, left, s.carry);
  let fits = notTaller(height(s.arena, s.carry), height(s.arena, left));
  return joinState(s, if fits || result.fault != ok() then result else rotateLeft(result), remaining, true, false);
}

fn rightStep(s: Join) -> Join { return if s.done then s else if s.rebuilding then rightUp(s) else rightDown(s); }

// ---- joinLeft: the right rope is more than one level taller ----

fn leftBase(arena: Arena, inner: U64, right: U64, short: U64) -> Built {
  let joined = branch(arena, short, inner);
  return if joined.fault != ok() then joined
    else if notTaller(height(joined.arena, joined.root), height(joined.arena, right))
      then branch(joined.arena, joined.root, right)
      else rotateRight(branchOn(rotateLeft(joined), rotateLeft(joined).root, right));
}

fn leftDown(s: Join) -> Join {
  let n = node(s.arena, s.cur);
  let hs = height(s.arena, s.short);
  return if !open(s.arena, s.cur) then joinState(s, faulted(s.arena, closureFault()), 0u64, true, true)
    else if hs < 255u64 && height(s.arena, n.left) <= hs + 1u64
      then joinState(s, leftBase(s.arena, n.left, n.right, s.short), listLen(s.path), true, false)
    else if listLen(s.path) < 32u64
      then { arena: s.arena, path: listAppend(s.path, n.right), remaining: 0u64, cur: n.left, short: s.short,
        rebuilding: false, done: false, carry: s.carry, fault: s.fault }
      else joinState(s, faulted(s.arena, capacityFault()), 0u64, true, true);
}

fn leftUp(s: Join) -> Join {
  return if 1u64 <= s.remaining && s.remaining - 1u64 < listLen(s.path)
    then leftPop(s, listAt(s.path, s.remaining - 1u64), s.remaining - 1u64)
    else joinState(s, { arena: s.arena, root: s.carry, fault: s.fault }, s.remaining, true, true);
}
fn leftPop(s: Join, right: U64, remaining: U64) -> Join {
  let result = branch(s.arena, s.carry, right);
  let fits = notTaller(height(s.arena, s.carry), height(s.arena, right));
  return joinState(s, if fits || result.fault != ok() then result else rotateRight(result), remaining, true, false);
}

fn leftStep(s: Join) -> Join { return if s.done then s else if s.rebuilding then leftUp(s) else leftDown(s); }

// ---- join ----

fn finished(s: Join) -> Built {
  return { arena: s.arena, root: s.carry, fault: if s.done then s.fault else incompleteFault() };
}

fn join(arena: Arena, l: U64, r: U64) -> Built {
  let hl = height(arena, l);
  let hr = height(arena, r);
  let start: Join = { arena, path: [], remaining: 0u64, cur: if hr < hl then l else r, short: if hr < hl then r else l,
    rebuilding: false, done: false, carry: absent(), fault: ok() };
  return if !present(arena, l) then { arena, root: r, fault: ok() }
    else if !present(arena, r) then { arena, root: l, fault: ok() }
    else if hr < 255u64 && hr + 1u64 < hl then finished(fold(start, rightStep, 66u64))
    else if hl < 255u64 && hl + 1u64 < hr then finished(fold(start, leftStep, 66u64))
    else branch(arena, l, r);
}
