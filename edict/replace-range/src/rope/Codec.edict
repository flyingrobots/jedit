// Canonical CBOR for the schema-2 text facts (`edict.canonical-cbor/v1`).
//
// Each atom is a definite-length map keyed by field name, keys in canonical
// order (shorter first, then bytewise), every integer in its shortest form.
// Decoding is exact: a well-typed atom in any other spelling, with another
// field set or with trailing bytes is Malformed.
package jedit.text.codec@1;

use module jedit.text.octets@1 digest "sha256:ad9eea0f13427a87ea9ad07fc8f54cae4e97073e8e13cb0475060e4fcebf6c91" as octets;

failure Malformed;

// The largest atom a schema-2 text fact can have: a Leaf with 4,096 bytes.
type Atom = Bytes<max=4352>;
type Parsed = { value: U64, next: U64 };
// A decoded Leaf keeps the atom's bound; decoding proves it holds at most 4,096 bytes.
type LeafFact = { bytes: Atom, lineBreaks: U64 };
type BranchFact = { byteLength: U64, lineBreaks: U64, height: U64 };
type HeadFact = { byteLength: U64, lineCount: U64, sequence: U64 };
// A Buffer atom is at most 4,096 bytes. Its key stays in encoded form: the
// program never reads it, and rewriting the atom keeps it byte for byte.
type BufferAtom = Bytes<max=4096>;
type BufferFact = { version: U64, encodedKey: BufferAtom };

// ---- Encoding ----

fn quot(v: U64, d: U64) -> U64 { return default(checkedDiv(v, d), 0u64); }
fn rem(v: U64, d: U64) -> U64 { return default(checkedRem(v, d), 0u64); }
fn be2(v: U64) -> Bytes<max=2> { return octets.octet(rem(quot(v, 256u64), 256u64)) + octets.octet(rem(v, 256u64)); }
fn be4(v: U64) -> Bytes<max=4> { return be2(rem(quot(v, 65536u64), 65536u64)) + be2(rem(v, 65536u64)); }
fn be8(v: U64) -> Bytes<max=8> { return be4(quot(v, 4294967296u64)) + be4(rem(v, 4294967296u64)); }

// The initial octet major + info. Both are octets with a sum below 256 at
// every call; a sum that is not an octet would encode as no octet at all.
fn initial(major: U64, info: U64) -> Bytes<max=1> { return octets.octet(default(checkedAdd(major, info), 256u64)); }

// The shortest header for major type `major` (already shifted: 0 unsigned,
// 64 byte string, 96 text string, 160 map) and argument v.
fn header(major: U64, v: U64) -> Bytes<max=9> {
  return if v < 24u64 then initial(major, v)
    else if v < 256u64 then initial(major, 24u64) + octets.octet(v)
    else if v < 65536u64 then initial(major, 25u64) + be2(v)
    else if v < 4294967296u64 then initial(major, 26u64) + be4(v)
    else initial(major, 27u64) + be8(v);
}
fn uint(v: U64) -> Bytes<max=9> { return header(0u64, v); }

fn leafAtom(bytes: Bytes<max=4096>, lineBreaks: U64) -> Atom {
  return b"\xa2\x65bytes" + header(64u64, len(bytes)) + bytes + b"\x6alineBreaks" + uint(lineBreaks);
}
fn branchAtom(fact: BranchFact) -> Atom {
  return b"\xa3\x66height" + uint(fact.height) + b"\x6abyteLength" + uint(fact.byteLength)
    + b"\x6alineBreaks" + uint(fact.lineBreaks);
}
fn headAtom(fact: HeadFact) -> Atom {
  return b"\xa3\x68sequence" + uint(fact.sequence) + b"\x69lineCount" + uint(fact.lineCount)
    + b"\x6abyteLength" + uint(fact.byteLength);
}
fn bufferAtom(fact: BufferFact) -> Bytes<max=4200> {
  return b"\xa2\x67version" + uint(fact.version) + b"\x69bufferKey" + fact.encodedKey;
}

// ---- Decoding ----

// The octet at i, widened.
fn octetAt(a: Atom, i: U64) -> U64 fails Malformed {
  return if i < len(a) then octets.widen(at(a, i)) else fail Malformed;
}

// The position after the literal lit, which must start at i.
fn literal(a: Atom, i: U64, lit: Bytes<max=16>) -> U64 fails Malformed {
  let end = checkedAdd(i, len(lit));
  return if isSome(end) && i <= unwrap(end) && unwrap(end) <= len(a) && slice(a, i, unwrap(end)) == lit
    then unwrap(end) else fail Malformed;
}

// Appends the octet at p.next to the big-endian value p.value.
fn more(a: Atom, p: Parsed) -> Parsed fails Malformed {
  let b = expect octetAt(a, p.next);
  let shifted = checkedMul(p.value, 256u64);
  let value = if isSome(shifted) then checkedAdd(unwrap(shifted), b) else none();
  let next = checkedAdd(p.next, 1u64);
  return if isSome(value) && isSome(next) then { value: unwrap(value), next: unwrap(next) } else fail Malformed;
}

fn more2(a: Atom, p: Parsed) -> Parsed fails Malformed { let q = expect more(a, p); return expect more(a, q); }
fn more4(a: Atom, p: Parsed) -> Parsed fails Malformed { let q = expect more2(a, p); return expect more2(a, q); }
fn more8(a: Atom, p: Parsed) -> Parsed fails Malformed { let q = expect more4(a, p); return expect more4(a, q); }

// Requires the shortest encoding: a wider argument must hold a value the
// narrower one could not.
fn atLeast(p: Parsed, floor: U64) -> Parsed fails Malformed {
  return if floor <= p.value then p else fail Malformed;
}

// The argument of a header whose additional information is info, starting at i.
fn argument(a: Atom, i: U64, info: U64) -> Parsed fails Malformed {
  let start: Parsed = { value: 0u64, next: i };
  return if info < 24u64 then { value: info, next: i }
    else if info == 24u64 then expect atLeast(expect more(a, start), 24u64)
    else if info == 25u64 then expect atLeast(expect more2(a, start), 256u64)
    else if info == 26u64 then expect atLeast(expect more4(a, start), 65536u64)
    else if info == 27u64 then expect atLeast(expect more8(a, start), 4294967296u64)
    else fail Malformed;
}

// A data item header of major type major (shifted) at i.
fn item(a: Atom, i: U64, major: U64) -> Parsed fails Malformed {
  let h = expect octetAt(a, i);
  let info = checkedSub(h, major);
  let after = checkedAdd(i, 1u64);
  return if isSome(info) && isSome(after) && unwrap(info) < 32u64
    then expect argument(a, unwrap(after), unwrap(info)) else fail Malformed;
}

fn uintAt(a: Atom, i: U64) -> Parsed fails Malformed { return expect item(a, i, 0u64); }

fn ending(a: Atom, p: Parsed) -> U64 fails Malformed {
  return if p.next == len(a) then p.value else fail Malformed;
}

fn decodeHead(a: Atom) -> HeadFact fails Malformed {
  let sequence = expect uintAt(a, expect literal(a, 0u64, b"\xa3\x68sequence"));
  let lineCount = expect uintAt(a, expect literal(a, sequence.next, b"\x69lineCount"));
  let byteLength = expect uintAt(a, expect literal(a, lineCount.next, b"\x6abyteLength"));
  let last = expect ending(a, byteLength);
  return { byteLength: last, lineCount: lineCount.value, sequence: sequence.value };
}

// A Branch height is a U8 in schema 2.
fn decodeBranch(a: Atom) -> BranchFact fails Malformed {
  let height = expect uintAt(a, expect literal(a, 0u64, b"\xa3\x66height"));
  let byteLength = expect uintAt(a, expect literal(a, height.next, b"\x6abyteLength"));
  let lineBreaks = expect uintAt(a, expect literal(a, byteLength.next, b"\x6alineBreaks"));
  let last = expect ending(a, lineBreaks);
  return if height.value <= 255u64 then { byteLength: byteLength.value, lineBreaks: last, height: height.value }
    else fail Malformed;
}

fn decodeLeaf(a: Atom) -> LeafFact fails Malformed {
  let size = expect item(a, expect literal(a, 0u64, b"\xa2\x65bytes"), 64u64);
  let end = checkedAdd(size.next, size.value);
  let bytes = if isSome(end) && size.next <= unwrap(end) && unwrap(end) <= len(a) && size.value <= 4096u64
    then slice(a, size.next, unwrap(end)) else b"";
  let lineBreaks = if isSome(end) then expect uintAt(a, expect literal(a, unwrap(end), b"\x6alineBreaks")) else { value: 0u64, next: 0u64 };
  let last = expect ending(a, lineBreaks);
  return if isSome(end) && len(bytes) == size.value then { bytes, lineBreaks: last } else fail Malformed;
}

fn decodeBuffer(a: BufferAtom) -> BufferFact fails Malformed {
  let version = expect uintAt(a, expect literal(a, 0u64, b"\xa2\x67version"));
  let keyStart = expect literal(a, version.next, b"\x69bufferKey");
  let key = expect item(a, keyStart, 96u64);
  let end = checkedAdd(key.next, key.value);
  return if isSome(end) && unwrap(end) == len(a) && keyStart <= len(a) && key.next <= len(a)
      && isUtf8(slice(a, key.next, len(a)))
    then { version: version.value, encodedKey: slice(a, keyStart, len(a)) }
    else fail Malformed;
}
