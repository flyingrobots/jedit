package jedit.text.replace_range@1;

use lawpack jedit.text@1 digest "sha256:95758c1605894672cc9069fde01bb8b6e11842b053102660c9cd4f4d6f34d64e" as text;

type Input = {
  basisPayload: text.ReplacementBytes,
  observedPayload: text.ReplacementBytes,
};

type Comparison = {
  samePayload: U32,
};

intent replaceRange(input: Input) returns Comparison
  profile text.replaceRange
  basis none
  budget <= text.replaceRangeBudget
{
  let samePayload = if input.observedPayload == input.basisPayload then 1u32 else 0u32;
  return { samePayload };
}
