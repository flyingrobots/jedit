package jedit.iterative.effect_repeated@1;
use lawpack jedit.text@1 digest "sha256:f50872ced6d229170258ad145c4d1d14ee341716f5b454ab50a27538787eed0b" as text;
type Output = { key: String<max=64>, message: String<max=256> };
intent create(input: text.CreateInput) returns Output
  profile text.createValue basis input.basis budget <= text.createBudget
{
  let first: text.CreateReceipt = text.createValue(input) else { alreadyExists(existing) => text.AlreadyCreated };
  let last: text.CreateReceipt = text.createValue(input) else { alreadyExists(existing) => text.AlreadyCreated };
  return { key: last.key, message: input.message };
}
