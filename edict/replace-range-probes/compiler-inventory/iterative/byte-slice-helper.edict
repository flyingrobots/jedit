package jedit.iterative.byte_slice_helper@1;
use lawpack jedit.text@1 digest "sha256:f50872ced6d229170258ad145c4d1d14ee341716f5b454ab50a27538787eed0b" as text;
type Input = { bytes: Bytes<max=8>, start: U64, end: U64 }; type Output = { bytes: Bytes<max=8> };
fn cut(bytes: Bytes<max=8>, start: U64, end: U64) -> Bytes<max=8> {
  return if start <= end && end <= len(bytes) && start <= len(bytes) then slice(bytes, start, end) else b"";
}
intent evaluate(input: Input) returns Output profile text.replaceRange basis none budget <= text.replaceRangeBudget {
  let bytes = cut(input.bytes, input.start, input.end); return { bytes };
}
