package jedit.iterative.subtraction_helper@1;
use lawpack jedit.text@1 digest "sha256:f50872ced6d229170258ad145c4d1d14ee341716f5b454ab50a27538787eed0b" as text;
type Input = { start: U64, end: U64 }; type Output = { value: U64 };
fn distance(start: U64, end: U64) -> U64 { return if start <= end then end - start else 0u64; }
intent evaluate(input: Input) returns Output profile text.replaceRange basis none budget <= text.replaceRangeBudget {
  let value = distance(input.start, input.end); return { value };
}
