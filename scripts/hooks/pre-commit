#!/usr/bin/env bash
# Lint gate: the same checks CI's quality job and TypeScript build enforce.
set -euo pipefail

hooks="$(dirname "${BASH_SOURCE[0]}")"
source "$hooks/lib/staged-content.sh"
source "$hooks/lib/enter-repository.sh"
refuse_partial_staging
enter_repository

echo "pre-commit: quality gate"
npm run --silent quality

echo "pre-commit: typecheck"
npx --no-install tsc -p tsconfig.json --noEmit
