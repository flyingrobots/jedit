  "workflows": [
    {
      "id": "open-edit-save-reopen",
      "title": "Open, Edit, Save, Reopen",
      "actor": "developer",
      "humanTask": "Open jedit in a project, select a file through Vim command UX, edit text, save, quit, and verify the file on disk.",
      "matrixRows": [
        "ex.edit",
        "ex.write-quit",
        "motion.character",
        "motion.line-boundary",
        "motion.file-boundary"
      ],
      "expectedCurrentOutcome": "partially-supported",
      "witness": {
        "command": "node scripts/jedit-vim-power-witness.mjs --json --workflow open-edit-save-reopen",
        "workspace": {
          "cwd": "/tmp/jedit-vim-power/open-edit-save-reopen",
          "files": [
            {
              "path": "main.txt",
              "contents": "alpha\nbeta\n"
            }
          ]
        },
        "steps": [
          {
            "id": "launch",
            "input": "jedit",
            "expect": "title screen opens in the current working directory"
          },
          {
            "id": "open-file",
            "input": ":edit main.txt<Enter>",
            "expect": "main.txt opens and command completion can explain the selected path"
          },
          {
            "id": "insert-text",
            "input": "G0iabcdefghijklmnopqrstuvwxyz12343567890!@#$%^&*()_+-=[]'/\\\\.,<Esc>",
            "expect": "all inserted ASCII punctuation and numbers appear in the file buffer"
          },
          {
            "id": "save-and-quit",
            "input": ":wq<Enter>",
            "expect": "jedit saves the production text session to disk and exits cleanly"
          },
          {
            "id": "verify-disk",
            "input": "cat main.txt",
            "expect": "the file contains the inserted text and original trailing content"
          }
        ],
        "requiredFacts": [
          "workflowId",
          "openedPath",
          "insertedTextDigest",
          "saveReceiptId",
          "finalDiskDigest"
        ]
      }
    },
    {
